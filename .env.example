# ==============================================================================
# Python P2P CLI Chat - Environment Configuration Example
# ==============================================================================
# Copy this file to .env locally:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
#
# NOTE: .env contains machine-specific local settings and must NOT be committed to Git.
# ==============================================================================

# Signaling Server Configuration (Device running server.py)
# SERVER_HOST: IP address the signaling server binds to (0.0.0.0 binds to all network interfaces)
SERVER_HOST=0.0.0.0
# SERVER_PORT: TCP port for the signaling server (default: 5000)
SERVER_PORT=5000

# Client Connection Configuration (Device running client.py)
# SIGNALING_SERVER_IP: The actual IPv4 LAN address of Device 1 running the signaling server.
# Find this on Device 1 using 'ipconfig' (e.g., 192.168.1.50). Do NOT use 127.0.0.1 on Device 2!
SIGNALING_SERVER_IP=192.168.1.10

# CLIENT_LISTEN_HOST: Interface for incoming direct P2P connections (0.0.0.0 listens on all interfaces)
CLIENT_LISTEN_HOST=0.0.0.0
# CLIENT_LISTEN_PORT: Port for incoming direct P2P chat connections.
# Use different ports on each client if testing multiple clients on the same machine (e.g., 6001, 6002).
CLIENT_LISTEN_PORT=6001

# Optional Preset Username (leave empty to be prompted interactively)
CLIENT_USERNAME=

# Application & Logging Configuration
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# DEBUG_MODE: Set to true for verbose socket/handshake debugging output
DEBUG_MODE=false
